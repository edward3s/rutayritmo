---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Página no encontrada"
  description="La página que buscas no existe o se ha movido. The page you are looking for does not exist or has moved."
  noindex
>
  <div class="wrap not-found">
    <h1>404</h1>
    <p>
      Esta página no existe, se ha movido o nunca llegó a la meta. Puedes volver al
      diario, revisar las rutas o buscar lo que necesitas.
    </p>
    <p lang="en">
      This page does not exist, has moved or never reached the finish line. You can go
      back to the journal, check the routes or search for what you need.
    </p>
    <div class="not-found__links">
      <a class="button" href="/diario/">Ir al diario</a>
      <a class="text-link" href="/rutas/">Ver rutas</a>
      <a class="text-link" href="/buscar/">Buscar</a>
    </div>
    <div class="not-found__links" lang="en">
      <a class="button" href="/en/diario/">Go to the journal</a>
      <a class="text-link" href="/en/rutas/">View routes</a>
      <a class="text-link" href="/en/buscar/">Search</a>
    </div>
  </div>
</BaseLayout>
