---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page not found"
  description="The page you are looking for does not exist or has moved."
  noindex
>
  <div class="wrap not-found">
    <h1>404</h1>
    <p>
      This page does not exist, has moved or never reached the finish line. You can go
      back to the journal, check the routes or search for what you need.
    </p>
    <div class="not-found__links">
      <a class="button" href="/en/diario/">Go to the journal</a>
      <a class="text-link" href="/en/rutas/">View routes</a>
      <a class="text-link" href="/en/buscar/">Search</a>
    </div>
  </div>
</BaseLayout>
