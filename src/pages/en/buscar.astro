---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { t } from '../../i18n/ui';

const lang = 'en' as const;
const s = {
  start: t(lang, 'searchStart'),
  loading: t(lang, 'searchLoading'),
  prompt: t(lang, 'searchPrompt'),
  noResults: t(lang, 'searchNoResults'),
  tryAnother: t(lang, 'searchTryAnother'),
  result: t(lang, 'searchResult'),
  results: t(lang, 'searchResults'),
  searchFor: t(lang, 'searchFor'),
  error: t(lang, 'searchError'),
};
---

<BaseLayout
  title={t(lang, 'searchTitle')}
  description={t(lang, 'searchDescription')}
  noindex
>
  <div class="wrap search">
    <Breadcrumbs
      items={[
        { label: t(lang, 'home'), href: '/en/' },
        { label: t(lang, 'searchTitle') },
      ]}
    />

    <header class="page__header">
      <h1>{t(lang, 'searchTitle')}</h1>
      <p>{t(lang, 'searchIntro')}</p>
    </header>

    <form class="search__form" role="search" id="search-form">
      <label class="visually-hidden" for="q">{t(lang, 'searchLabel')}</label>
      <input
        id="q"
        name="q"
        type="search"
        placeholder={t(lang, 'searchPlaceholder')}
        autocomplete="off"
      />
      <button type="submit">{t(lang, 'searchButton')}</button>
    </form>

    <p class="search__status" id="status" role="status" aria-live="polite">
      {t(lang, 'searchStart')}
    </p>

    <ul class="search__results" id="resultados"></ul>

    <noscript>
      <p class="search__status">
        {t(lang, 'searchNoJs')}{' '}
        <a href="/en/diario/">{t(lang, 'searchArchive')}</a> or the{' '}
        <a href="/en/rutas/">{t(lang, 'searchRoutes')}</a>.
      </p>
    </noscript>
  </div>

  <script is:inline define:vars={{ s }}>
    (() => {
      const form = document.getElementById('search-form');
      const input = document.getElementById('q');
      const status = document.getElementById('status');
      const list = document.getElementById('resultados');

      const normalize = (value) =>
        value
          .normalize('NFD')
          .replace(/[\u0300-\u036f]/g, '')
          .toLowerCase();

      let index = [];
      let ready = false;

      const render = () => {
        const query = normalize(input.value.trim());
        list.innerHTML = '';

        if (!query) {
          status.textContent = ready ? s.prompt : s.loading;
          return;
        }

        if (!ready) {
          status.textContent = s.loading;
          return;
        }

        const results = index
          .filter((item) =>
            normalize(`${item.title} ${item.description} ${item.category}`).includes(query),
          )
          .slice(0, 20);

        status.textContent =
          results.length === 0
            ? `${s.noResults} “${input.value.trim()}”. ${s.tryAnother}`
            : `${results.length} ${results.length === 1 ? s.result : s.results} ${s.searchFor} “${input.value.trim()}”.`;

        results.forEach((item) => {
          const li = document.createElement('li');
          li.className = 'search-result';

          const link = document.createElement('a');
          link.href = item.url;
          link.textContent = item.title;

          const description = document.createElement('p');
          description.textContent = item.description;

          const meta = document.createElement('p');
          meta.className = 'meta';
          meta.textContent = `${item.type} · ${item.category}`;

          li.append(link, description, meta);
          list.append(li);
        });
      };

      const sync = () => {
        const params = new URLSearchParams(window.location.search);
        input.value = params.get('q') ?? '';
        render();
      };

      fetch('/en/buscar.json')
        .then((response) => {
          if (!response.ok) throw new Error('Could not load the index');
          return response.json();
        })
        .then((data) => {
          index = data;
          ready = true;
          render();
        })
        .catch(() => {
          status.textContent = s.error;
        });

      input.addEventListener('input', render);

      form.addEventListener('submit', (event) => {
        event.preventDefault();
        const query = input.value.trim();
        const url = query ? `/en/buscar/?q=${encodeURIComponent(query)}` : '/en/buscar/';
        window.history.replaceState({}, '', url);
        window.dispatchEvent(new Event('rutayritmo:search'));
        render();
        input.focus();
      });

      sync();
    })();
  </script>
</BaseLayout>
