---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getCollection } from 'astro:content';
import { AUTOR } from '../../data/autor';
import { SITE } from '../../data/site';
import { sortByDate } from '../../lib/utils';

export function getStaticPaths() {
  return [{ params: { slug: AUTOR.slug } }];
}

const articulos = sortByDate(await getCollection('articulos'));
const site = Astro.site ?? new URL(SITE.url);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: AUTOR.name,
  jobTitle: AUTOR.role,
  url: new URL(`/autor/${AUTOR.slug}/`, site).toString(),
};
---

<BaseLayout
  title={`${AUTOR.name}, autor de Ruta y Ritmo`}
  description={`Artículos de ${AUTOR.name} en Ruta y Ritmo.`}
  jsonLd={[jsonLd]}
>
  <div class="wrap page">
    <Breadcrumbs
      items={[
        { label: 'Inicio', href: '/' },
        { label: 'Autor', href: '/sobre/' },
        { label: AUTOR.name },
      ]}
    />

    <header class="page__header">
      <div class="article-kicker">
        <span class="category-tag" style="--cat: var(--primary)">Autor</span>
        <span>{articulos.length} artículos publicados</span>
      </div>
      <h1>{AUTOR.name}</h1>
    </header>

    <section class="section" aria-labelledby="articulos-autor">
      <div class="section-head">
        <h2 id="articulos-autor">Artículos de {AUTOR.name}</h2>
        <p>Todo lo publicado en el diario, de lo más reciente a lo más antiguo.</p>
      </div>

      <div class="card-grid">
        {articulos.map((entry) => <ArticleCard entry={entry} />)}
      </div>
    </section>
  </div>
</BaseLayout>
