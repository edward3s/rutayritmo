---
import { getLangFromPath, t } from '../i18n/ui';

const client = import.meta.env.PUBLIC_ADSENSE_CLIENT;
const slot = import.meta.env.PUBLIC_ADSENSE_SLOT;
const lang = getLangFromPath(Astro.url.pathname);
---

<aside class="ad" aria-label={t(lang, 'advertising')}>
  <p class="ad__label">{t(lang, 'advertising')}</p>

  {client && slot ? (
    <>
      <ins
        class="adsbygoogle"
        style="display:block"
        data-ad-client={client}
        data-ad-slot={slot}
        data-ad-format="auto"
        data-full-width-responsive="true"
      ></ins>
      <script is:inline>
        (window.adsbygoogle = window.adsbygoogle || []).push({});
      </script>
    </>
  ) : (
    <div class="ad__box">
      <p class="ad__placeholder">{t(lang, 'adPlaceholder')}</p>
    </div>
  )}
</aside>
