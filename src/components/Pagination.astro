---
import { getLangFromPath, localizedPath, t } from '../i18n/ui';

interface Props {
  currentPage: number;
  totalPages: number;
  basePath?: string;
}

const { currentPage, totalPages } = Astro.props;
const lang = getLangFromPath(Astro.url.pathname);
const basePath = Astro.props.basePath ?? localizedPath(lang, '/diario/');

const urlFor = (page: number) =>
  page === 1 ? basePath : `${basePath}pagina/${page}/`;
---

<nav class="pagination" aria-label={t(lang, 'pagination')}>
  <div>
    {currentPage > 1 ? (
      <a href={urlFor(currentPage - 1)}>{t(lang, 'previous')}</a>
    ) : (
      <span class="disabled">{t(lang, 'previous')}</span>
    )}
  </div>

  <ol class="pagination__pages">
    {Array.from({ length: totalPages }, (_, index) => index + 1).map((page) => (
      <li>
        {page === currentPage ? (
          <span aria-current="page">{page}</span>
        ) : (
          <a href={urlFor(page)} aria-label={`${t(lang, 'page')} ${page}`}>{page}</a>
        )}
      </li>
    ))}
  </ol>

  <div>
    {currentPage < totalPages ? (
      <a href={urlFor(currentPage + 1)}>{t(lang, 'next')}</a>
    ) : (
      <span class="disabled">{t(lang, 'next')}</span>
    )}
  </div>
</nav>
