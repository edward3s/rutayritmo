---
import type { CollectionEntry } from 'astro:content';
import { getCategoria } from '../data/categorias';
import { formatDate, readingTime } from '../lib/utils';
import { getLangFromPath, localizedPath, t } from '../i18n/ui';

type ArticleEntry = CollectionEntry<'articulos'> | CollectionEntry<'articulosEn'>;

interface Props {
  entry: ArticleEntry;
}

const { entry } = Astro.props;
const lang = getLangFromPath(Astro.url.pathname);
const categoria = getCategoria(entry.data.category, lang);
const url = localizedPath(lang, `/diario/${entry.id}/`);
const artPath =
  lang === 'en' ? `/images/articles/en/${entry.id}.svg` : `/images/articles/${entry.id}.svg`;
---

<article class="article-card">
  <div class="article-card__art" aria-hidden="true">
    <img
      src={artPath}
      width="1200"
      height="675"
      loading="lazy"
      decoding="async"
      alt=""
    />
  </div>

  <a
    class="category-tag"
    href={localizedPath(lang, `/diario/categoria/${categoria.slug}/`)}
    style={`--cat:${categoria.tone}`}
  >{categoria.name}</a>

  <h3 class="article-card__title">
    <a href={url}>{entry.data.title}</a>
  </h3>

  <p class="article-card__excerpt">{entry.data.description}</p>

  <div class="article-card__foot">
    <time datetime={entry.data.publishedAt.toISOString()}>{formatDate(entry.data.publishedAt, 'short', lang)}</time>
    <span>{readingTime(entry.body)} {t(lang, 'readMinutes')}</span>
  </div>
</article>
