---
import type { CollectionEntry } from 'astro:content';
import ArticleCard from './ArticleCard.astro';
import AdSlot from './AdSlot.astro';
import Pagination from './Pagination.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import { getCategoriaList } from '../data/categorias';
import { getLangFromPath, localizedPath, t } from '../i18n/ui';

type ArticleEntry = CollectionEntry<'articulos'> | CollectionEntry<'articulosEn'>;

interface Props {
  articulos: ArticleEntry[];
  currentPage: number;
  totalPages: number;
}

const { articulos, currentPage, totalPages } = Astro.props;
const lang = getLangFromPath(Astro.url.pathname);
const categorias = getCategoriaList(lang);
const pageLabel =
  currentPage === 1 ? t(lang, 'diaryTitle') : `${t(lang, 'diaryPage')} ${currentPage}`;
---

<div class="wrap page">
  <Breadcrumbs
    items={[
      { label: t(lang, 'home'), href: localizedPath(lang, '/') },
      { label: pageLabel },
    ]}
  />

  <header class="page__header">
    <h1>{t(lang, 'diaryTitle')}</h1>
    <p>{t(lang, 'diaryDescription')}</p>
  </header>

  <nav class="category-nav" aria-label={t(lang, 'categoriesNav')}>
    {categorias.map((categoria) => (
      <a href={localizedPath(lang, `/diario/categoria/${categoria.slug}/`)}>{categoria.name}</a>
    ))}
  </nav>

  <div class="card-grid">
    {articulos.map((entry) => <ArticleCard entry={entry} />)}
  </div>

  <AdSlot />

  <Pagination
    currentPage={currentPage}
    totalPages={totalPages}
    basePath={localizedPath(lang, '/diario/')}
  />
</div>
