---
import { getCategoriaList } from '../data/categorias';
import { SITE } from '../data/site';
import { getLangFromPath, localizedPath, t } from '../i18n/ui';

const lang = getLangFromPath(Astro.url.pathname);
const categorias = getCategoriaList(lang);
const year = new Date().getFullYear();
const link = (path: string) => localizedPath(lang, path);
---

<footer class="site-footer">
  <div class="wrap">
    <div class="footer__grid">
      <div class="footer__brand">
        <a class="wordmark" href={link('/')} aria-label={`${SITE.name}, ${t(lang, 'home')}`}>RUTA Y RITMO</a>
        <p>{t(lang, 'homeLede')}</p>
      </div>

      <div class="footer__col">
        <h2>{t(lang, 'sections')}</h2>
        <ul>
          <li><a href={link('/diario/')}>{t(lang, 'diary')}</a></li>
          <li><a href={link('/rutas/')}>{t(lang, 'routes')}</a></li>
          {categorias.map((categoria) => (
            <li><a href={link(`/diario/categoria/${categoria.slug}/`)}>{categoria.name}</a></li>
          ))}
        </ul>
      </div>

      <div class="footer__col">
        <h2>Ruta y Ritmo</h2>
        <ul>
          <li><a href={link('/sobre/')}>{t(lang, 'aboutBlog')}</a></li>
          <li><a href={link('/autor/eduard/')}>{t(lang, 'author')}</a></li>
          <li><a href={link('/politica-editorial/')}>{t(lang, 'editorialPolicy')}</a></li>
        </ul>
      </div>

      <div class="footer__col">
        <h2>{t(lang, 'legal')}</h2>
        <ul>
          <li><a href={link('/privacidad/')}>{t(lang, 'privacy')}</a></li>
          <li><a href={link('/cookies/')}>{t(lang, 'cookies')}</a></li>
          <li><a href={link('/aviso-legal/')}>{t(lang, 'legalNotice')}</a></li>
          <li><a href={link('/afiliados/')}>{t(lang, 'affiliates')}</a></li>
          <li><a href={link('/rss.xml')}>RSS</a></li>
        </ul>
      </div>
    </div>

    <div class="footer__bottom">
      <p>© {year} Ruta y Ritmo. {t(lang, 'footerTagline')}</p>
      <p>{t(lang, 'footerNoMiracle')} <a href={link('/rss.xml')}>{t(lang, 'rss')}</a></p>
    </div>
  </div>
</footer>
