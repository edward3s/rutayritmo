---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import Analytics from '@vercel/analytics/astro';
import { SITE } from '../data/site';
import { AUTOR } from '../data/autor';
import {
  alternateLangPath,
  getLangFromPath,
  localizedPath,
  t,
} from '../i18n/ui';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  publishedTime?: string;
  modifiedTime?: string;
  section?: string;
  jsonLd?: Record<string, unknown>[];
}

const {
  title = SITE.title,
  description = SITE.description,
  image = '/og-default.png',
  type = 'website',
  noindex = false,
  publishedTime,
  modifiedTime,
  section,
  jsonLd = [],
} = Astro.props;

const lang = getLangFromPath(Astro.url.pathname);
const site = Astro.site ?? new URL(SITE.url);
const canonical = new URL(Astro.url.pathname, site);
const imageUrl = new URL(image, site);
const pageTitle = title.includes(SITE.name) ? title : `${title} | ${SITE.name}`;
const adsenseClient = import.meta.env.PUBLIC_ADSENSE_CLIENT;

const currentPath = `${Astro.url.pathname}${Astro.url.search}`;
const is404 = /^\/(en\/)?404\/?$/.test(Astro.url.pathname);
const spanishPath = is404
  ? '/'
  : lang === 'es'
    ? currentPath
    : alternateLangPath(Astro.url.pathname, Astro.url.search);
const englishPath = is404
  ? '/en/'
  : lang === 'en'
    ? currentPath
    : localizedPath('en', currentPath);
const rssPath = lang === 'en' ? '/en/rss.xml' : '/rss.xml';
const tableHint = t(lang, 'tableHint');
const tableAria = t(lang, 'dataTable');
const ogAlt = t(lang, 'ogAlt');
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es" href={new URL(spanishPath, site)} />
    <link rel="alternate" hreflang="en" href={new URL(englishPath, site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(spanishPath, site)} />

    <meta
      name="robots"
      content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'}
    />
    <meta name="author" content={AUTOR.name} />
    <meta name="theme-color" content="#E8EDF0" />
    <meta name="color-scheme" content="light" />
    <meta name="generator" content={Astro.generator} />
    <meta name="format-detection" content="telephone=no" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : SITE.locale} />
    <meta
      property="og:locale:alternate"
      content={lang === 'en' ? SITE.locale : 'en_US'}
    />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {section && <meta property="article:section" content={section} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={ogAlt} />

    {adsenseClient && <meta name="google-adsense-account" content={adsenseClient} />}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/site.webmanifest" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={t(lang, 'rssTitle')}
      href={new URL(rssPath, site)}
    />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Anton&family=Instrument+Sans:ital,wght@0,400..700;1,400&display=swap"
      rel="stylesheet"
    />

    {jsonLd.map((data) => (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(data).replace(/</g, '\\u003c')}
      />
    ))}

    <Analytics />
  </head>

  <body>
    <a class="skip" href="#contenido">{t(lang, 'skip')}</a>
    <Header />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
    <CookieBanner />
    <script is:inline define:vars={{ tableHint, tableAria }}>
      (() => {
        document.querySelectorAll('.prose table').forEach((table) => {
          if (table.closest('.table-scroll')) return;
          const wrapper = document.createElement('div');
          wrapper.className = 'table-scroll';
          wrapper.tabIndex = 0;
          wrapper.setAttribute('role', 'region');
          wrapper.setAttribute(
            'aria-label',
            table.querySelector('caption')?.textContent?.trim() || tableAria,
          );
          table.parentNode.insertBefore(wrapper, table);
          wrapper.appendChild(table);

          const hint = document.createElement('p');
          hint.className = 'table-hint';
          hint.textContent = tableHint;
          wrapper.parentNode.insertBefore(hint, wrapper);
        });
      })();
    </script>
  </body>
</html>
