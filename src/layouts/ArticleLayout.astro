---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ArticleCard from '../components/ArticleCard.astro';
import AdSlot from '../components/AdSlot.astro';
import { getCategoria } from '../data/categorias';
import { AUTOR } from '../data/autor';
import { SITE } from '../data/site';
import { formatDate, readingTime } from '../lib/utils';
import { getLangFromPath, localizedPath, t } from '../i18n/ui';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

type ArticleEntry = CollectionEntry<'articulos'> | CollectionEntry<'articulosEn'>;

interface Props {
  entry: ArticleEntry;
  headings: Heading[];
  related: ArticleEntry[];
}

const { entry, headings, related } = Astro.props;
const lang = getLangFromPath(Astro.url.pathname);
const categoria = getCategoria(entry.data.category, lang);
const url = localizedPath(lang, `/diario/${entry.id}/`);
const minutes = readingTime(entry.body);
const updated = entry.data.updatedAt ?? entry.data.publishedAt;

const site = Astro.site ?? new URL(SITE.url);
const canonical = new URL(url, site).toString();
const image = new URL(
  lang === 'en' ? `/images/og/en/${entry.id}.png` : `/images/og/${entry.id}.png`,
  site,
).toString();
const artPath =
  lang === 'en' ? `/images/articles/en/${entry.id}.svg` : `/images/articles/${entry.id}.svg`;

const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);

const blogPosting = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: entry.data.title,
  description: entry.data.description,
  datePublished: entry.data.publishedAt.toISOString(),
  dateModified: updated.toISOString(),
  author: {
    '@type': 'Person',
    name: AUTOR.name,
    url: new URL(localizedPath(lang, `/autor/${AUTOR.slug}/`), site).toString(),
  },
  publisher: {
    '@type': 'Organization',
    name: SITE.name,
    url: site.toString(),
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonical,
  },
  image: [image],
  articleSection: categoria.name,
  inLanguage: lang === 'en' ? 'en-US' : 'es-ES',
  isAccessibleForFree: true,
};

const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: t(lang, 'home'),
      item: new URL(localizedPath(lang, '/'), site).toString(),
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: t(lang, 'diaryTitle'),
      item: new URL(localizedPath(lang, '/diario/'), site).toString(),
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: categoria.name,
      item: new URL(localizedPath(lang, `/diario/categoria/${categoria.slug}/`), site).toString(),
    },
    {
      '@type': 'ListItem',
      position: 4,
      name: entry.data.title,
      item: canonical,
    },
  ],
};
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  type="article"
  publishedTime={entry.data.publishedAt.toISOString()}
  modifiedTime={updated.toISOString()}
  section={categoria.name}
  image={image}
  jsonLd={[blogPosting, breadcrumbs]}
>
  <div class="wrap">
    <Breadcrumbs
      items={[
        { label: t(lang, 'home'), href: localizedPath(lang, '/') },
        { label: t(lang, 'diaryTitle'), href: localizedPath(lang, '/diario/') },
        {
          label: categoria.name,
          href: localizedPath(lang, `/diario/categoria/${categoria.slug}/`),
        },
        { label: entry.data.title },
      ]}
    />

    <header class="article-header">
      <div class="article-kicker">
        <a
          class="category-tag"
          href={localizedPath(lang, `/diario/categoria/${categoria.slug}/`)}
          style={`--cat:${categoria.tone}`}
        >{categoria.name}</a>
        <span>{minutes} {t(lang, 'readMinutes')}</span>
      </div>

      <h1 class="article-title">{entry.data.title}</h1>
      <p class="article-dek">{entry.data.description}</p>

      <div class="article-byline">
        <span>{t(lang, 'by')} <a href={localizedPath(lang, `/autor/${AUTOR.slug}/`)}>{AUTOR.name}</a></span>
        <time datetime={entry.data.publishedAt.toISOString()}>
          {formatDate(entry.data.publishedAt, 'long', lang)}
        </time>
        {entry.data.updatedAt && (
          <span>{t(lang, 'updatedOn')} {formatDate(entry.data.updatedAt, 'long', lang)}</span>
        )}
      </div>
    </header>

    <div class="article-art" aria-hidden="true">
      <img
        src={artPath}
        width="1200"
        height="675"
        fetchpriority="high"
        alt=""
      />
    </div>

    <AdSlot />

    <div class="article-layout">
      <aside class="article-aside">
        {toc.length > 1 && (
          <nav class="toc" aria-label={t(lang, 'inThisArticle')}>
            <p class="toc__title">{t(lang, 'inThisArticle')}</p>
            <ol>
              {toc.map((heading) => (
                <li data-depth={heading.depth}>
                  <a href={`#${heading.slug}`}>{heading.text}</a>
                </li>
              ))}
            </ol>
          </nav>
        )}

        <div class="author-mini">
          <span class="avatar" aria-hidden="true">{AUTOR.name.slice(0, 1)}</span>
          <div>
            <p class="author-mini__name"><a href={localizedPath(lang, `/autor/${AUTOR.slug}/`)}>{AUTOR.name}</a></p>
            <p class="author-mini__role">{t(lang, 'author')}</p>
          </div>
        </div>
      </aside>

      <div class="article-body">
        <div class="prose">
          <slot />
        </div>

        {entry.data.medical && (
          <aside class="medical-note">
            <strong>{t(lang, 'medicalTitle')}</strong> {t(lang, 'medicalBody')}
          </aside>
        )}

        {entry.data.sources.length > 0 && (
          <section class="sources" aria-labelledby="fuentes-title">
            <h2 id="fuentes-title">{t(lang, 'sources')}</h2>
            <ul>
              {entry.data.sources.map((source) => (
                <li>
                  <a href={source.url} target="_blank" rel="noopener noreferrer">
                    {source.title}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}

        <div class="author-box">
          <span class="avatar" aria-hidden="true">{AUTOR.name.slice(0, 1)}</span>
          <div>
            <h2>{AUTOR.name}</h2>
            <p>{t(lang, 'authorBoxBody')}</p>
            <a href={localizedPath(lang, `/autor/${AUTOR.slug}/`)}>{t(lang, 'authorBoxLink')}</a>
          </div>
        </div>

        <AdSlot />
      </div>
    </div>
  </div>

  {related.length > 0 && (
    <section class="wrap related" aria-labelledby="relacionados-title">
      <h2 id="relacionados-title">{t(lang, 'related')}</h2>
      <div class="card-grid">
        {related.map((item) => <ArticleCard entry={item} />)}
      </div>
    </section>
  )}
</BaseLayout>
